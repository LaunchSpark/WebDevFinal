{
  "name": "blockdraft",
  "version": "1.0.0",
  "description": "Block-based resume editor — CSC3100 Final",
  "productName": "BlockDraft",
  "main": "main.js",
  "scripts": {
    "start": "npm run rebuild:node && node server/app.js",
    "electron": "npm run electron:dev",
    "electron:dev": "npm run electron:rebuild && electron .",
    "electron:pack": "npm run electron:rebuild && node scripts/electron-builder.js --dir",
    "electron:dist": "npm run electron:rebuild && node scripts/electron-builder.js",
    "electron:rebuild": "node scripts/electron-builder.js install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3",
    "test": "npm run rebuild:node && jest",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./public/css/tailwind.css --minify"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "sweetalert2": "^11.26.24"
  },
  "devDependencies": {
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.1"
  },
  "build": {
    "appId": "com.lucasstarkey.blockdraft",
    "productName": "BlockDraft",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "public/**/*",
      "server/**/*",
      "!tests{,/**/*}",
      "!docs{,/**/*}",
      "!src{,/**/*}",
      "!LucasStarkeyResume.html",
      "!LighthouseScore.png"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icons"
    }
  },
  "jest": {
    "testMatch": [
      "**/tests/server/**/*.test.js"
    ],
    "testEnvironment": "node"
  }
}
